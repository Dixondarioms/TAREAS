{
  "name": "ferreteria-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "preview": "vite preview",
    "formato": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "formato:verificar": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
