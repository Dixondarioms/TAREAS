# Copie este archivo como .env y cambie los valores marcados.

# Clave de la base de datos (CAMBIAR; use una larga y aleatoria)
DB_CLAVE=cambie-esta-clave-de-base-de-datos

# Secreto para firmar las sesiones: mínimo 32 caracteres (CAMBIAR)
# Puede generarlo con:  openssl rand -base64 48
JWT_SECRETO=cambie-este-secreto-por-uno-largo-y-aleatorio-123456

# Duración de la sesión antes de pedir de nuevo la clave
JWT_DURACION=12h

# Administrador inicial (solo se usa si no existe ningún usuario).
# Si deja la clave vacía, se genera una aleatoria y se muestra en:  docker compose logs api
ADMIN_USUARIO=admin
ADMIN_CLAVE_INICIAL=

# Consulta automática de la tasa del BCV (requiere internet)
BCV_ACTUALIZACION_AUTOMATICA=true
# Si el BCV falla por certificado incompleto, coloque el certificado intermedio
# en ./certificados/bcv.pem y descomente:
# NODE_EXTRA_CA_CERTS=/certificados/bcv.pem

# Puerto de la aplicación en la red local (http://IP-DEL-SERVIDOR)
PUERTO_WEB=80

# Respaldo diario: hora (0-23) y días que se conservan
RESPALDO_HORA=23
RESPALDO_DIAS=30
